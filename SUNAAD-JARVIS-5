{
  "name": "sunaad-jarvis-5",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^5.0.0"
  }
}

import "dotenv/config";
import express from "express";
import OpenAI from "openai";

const app = express();
app.use(express.json({ limit: "1mb" }));
app.use(express.static("public"));

const apiKey = process.env.OPENAI_API_KEY;

if (!apiKey) {
  console.error("Missing OPENAI_API_KEY environment variable.");
  process.exit(1);
}

const openai = new OpenAI({ apiKey });

app.post("/api/chat", async (req, res) => {
  try {
    const messages = req.body.messages;
    const useWeb = req.body.useWeb === true;

    if (!Array.isArray(messages) || messages.length === 0) {
      return res.status(400).json({ error: "Please enter a message." });
    }

    const safeMessages = messages.slice(-20).map((m) => {
      if (!["user", "assistant"].includes(m.role)) {
        throw new Error("Invalid message role.");
      }
      return {
        role: m.role,
        content: String(m.content || "").slice(0, 12000)
      };
    });

    const response = await openai.responses.create({
      model: process.env.OPENAI_MODEL || "gpt-6-astra",
      instructions:
        "You are SUNAAD JARVIS, a helpful, friendly AI assistant. " +
        "Answer clearly and accurately. Explain school topics simply when asked. " +
        "Be honest when you do not know something. Never claim you performed " +
        "actions on the user's device unless an approved tool actually did it.",
      input: safeMessages,
      ...(useWeb ? { tools: [{ type: "web_search" }] } : {})
    });

    res.json({ reply: response.output_text || "I couldn't create a reply." });
  } catch (error) {
    console.error(error);
    res.status(500).json({
      error: "JARVIS could not connect. Check your server and API settings."
    });
  }
});

app.listen(3000, () => {
  console.log("SUNAAD JARVIS is running at http://localhost:3000");
});

